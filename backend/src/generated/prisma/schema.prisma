generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid())
  name     String @unique
  email    String @unique
  password String

  refreshToken RefreshToken[]
  post         Post[]
  comment      Comment[]

  createdAt  DateTime @default(now())
  updateddAt DateTime @default(now())
}

model RefreshToken {
  id     String @id @default(uuid())
  token  String
  userId String

  user User @relation(fields: [userId], references: [id])

  expiresAt DateTime
}

model Post {
  id          String  @id @default(uuid())
  title       String
  description String
  imageUrl    String?

  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  comment Comment[]

  user User @relation(fields: [userId], references: [id])
}

model Comment {
  id      String @id @default(uuid())
  Comment String

  postId String
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])
}
